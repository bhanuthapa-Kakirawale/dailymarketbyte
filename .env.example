# Copy this file to `.env` (same directory) and fill in real values.
# `.env` is git-ignored (see .gitignore) - it is never committed. This template IS committed
# so the required variable names are documented, but it must never itself hold a real key.
#
# config.py loads `.env` automatically on import (via python-dotenv), so every entry point
# (main.py, render_daily_market_byte.py, upload.py, ...) picks this up with no extra flags.
# A real environment variable already set by your shell or by CI/GitHub Actions secrets
# always takes priority over `.env` - this file only fills the gap for local runs.

# Free tier key from https://aistudio.google.com/apikey . Without it, the pipeline still runs:
# AI-only facts (GIFT Nifty, verified FII/DII) are omitted, reasons/events fall back to Google
# News RSS, and the Dynamic Hook Engine opens with its deterministic hook instead of Gemini's.
GEMINI_API_KEY=

# Optional: override the default Gemini model (see config.py for the current default).
# GEMINI_MODEL=gemini-3.7-flash

# GIFT Nifty display gate (docs/NSEIX_RIGHTS_REVIEW.md). DEFAULT OFF: NSE IX display rights are
# not approved. Enabling needs BOTH the flag and a written approval/licence reference - the flag
# alone never shows GIFT. Shadow runs still fetch and audit GIFT without displaying it.
# GIFT_NIFTY_PUBLICATION_ENABLED=false
# GIFT_NIFTY_PUBLICATION_APPROVAL=
